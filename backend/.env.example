# Anthropic API key for Claude extraction.
# ANTHROPIC_API_KEY=sk-ant-...

# Claude model and max tokens for ROI extraction.
# ROI_MODEL=claude-sonnet-4-20250514
# ROI_MAX_TOKENS=2048

# CORS origins (comma-separated). In production Alfred injects this.
# CORS_ORIGINS=http://localhost:5173


# ── Storage (uploads) ────────────────────────────────────────────────────────
# ON ALFRED: nothing to configure. The project has managed Postgres and
# managed bucket storage enabled, so Alfred injects DATABASE_URL and the
# BUCKET_* variables (NAME/REGION/ENDPOINT/ACCESS_KEY_ID/SECRET_ACCESS_KEY/
# PREFIX) automatically at every deploy. ANTHROPIC_API_KEY lives in the
# project's secret store and is injected too.
#
# LOCALLY: set DATABASE_URL to your local Postgres; the file store defaults
# to a local folder that mimics S3.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roi_tracker

# Durable file store backend override: "local" or "s3".
# Auto-detection: s3 when BUCKET_NAME (Alfred) or S3_BUCKET is set, else local.
# STORAGE_BACKEND=local

# local backend: where the S3-mimic folder lives (default backend/data/s3).
# FILE_STORE_DIR=

# Generic S3 (non-Alfred deployments only):
# S3_BUCKET=
# S3_PREFIX=roi-tracker
# S3_ENDPOINT_URL=            # only for R2/MinIO-style S3-compatible stores
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# Local dev ports: backend 3599 (python main.py), frontend 3600 (vite).
# PORT=3599
