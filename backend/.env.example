# Base URL of the Alfred deployment platform.
ALFRED_BASE_URL=https://alfred-production-fdeb.up.railway.app

# Anthropic API key for Claude extraction.
# ANTHROPIC_API_KEY=sk-ant-...

# Claude model and max tokens for ROI extraction.
# ROI_MODEL=claude-sonnet-4-20250514
# ROI_MAX_TOKENS=2048

# CORS origins (comma-separated). In production Alfred injects this.
# CORS_ORIGINS=http://localhost:5173

# API key used by Domo / BI tools to read saved tracker records.
# Set this to a strong secret value and do not commit it.
# TRACKER_API_KEY=your-secure-tracker-api-key

# Optional: path to cache the acquired Alfred access token (gitignored).
# ALFRED_TOKEN_FILE=.alfred_token.json

# ── Storage (uploads) ────────────────────────────────────────────────────────
# Postgres for file metadata (the file ID ↔ filename ↔ storage key mapping).
# Local dev: your local Postgres. On Alfred: injected as a service secret.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roi_tracker

# Durable file store backend: "local" (folder mimicking S3, default) or "s3".
# If unset, "s3" is chosen automatically when S3_BUCKET is set.
# STORAGE_BACKEND=local

# local backend: where the S3-mimic folder lives (default backend/data/s3).
# FILE_STORE_DIR=

# s3 backend (Alfred): bucket + standard AWS credentials via env.
# S3_BUCKET=
# S3_PREFIX=roi-tracker
# S3_ENDPOINT_URL=            # only for R2/MinIO-style S3-compatible stores
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# Local dev ports: backend 3599 (python main.py), frontend 3600 (vite).
# PORT=3599
